{
  "expo": {
    "name": "CHATLAB",
    "slug": "chatlab",
    "scheme": "chatlab",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thebimhouseinfo.chatlab",
      "infoPlist": {
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "NSMicrophoneUsageDescription": "CHATLAB sử dụng microphone khi bạn chủ động bật Voice Test.",
        "NSSpeechRecognitionUsageDescription": "CHATLAB sử dụng dịch vụ nhận dạng giọng nói theo yêu cầu trong Voice Test."
      }
    },
    "android": {
      "package": "com.thebimhouseinfo.chatlab",
      "permissions": [
        "INTERNET"
      ]
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "CHATLAB cần microphone để nhận câu nói khi bạn nhấn Nói.",
          "speechRecognitionPermission": "CHATLAB nhận dạng giọng nói thành chữ để thử voice benchmark.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts",
            "com.google.android.as"
          ]
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0"
          },
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "llama.rn",
        {
          "enableEntitlements": true,
          "entitlementsProfile": "production",
          "forceCxx20": true,
          "enableOpenCL": false
        }
      ]
    ],
    "extra": {
      "buildProfile": "native-local-llm-test"
    }
  }
}
